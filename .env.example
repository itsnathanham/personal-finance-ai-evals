# Environment template — copy to .env.local

# Required for chat + evals
# Tip: when piping into `vercel env add`, load dotenv quietly so its ◇ tip
# doesn't get captured into the secret (e.g. dotenv config({ quiet: true })).
ANTHROPIC_API_KEY=

# Optional model override (must be in the Claude registry)
ANTHROPIC_MODEL=claude-sonnet-5

# Admin dashboard (/admin)
ADMIN_PASSWORD=changeme
# Optional: separate cookie signing secret (defaults to ADMIN_PASSWORD)
# ADMIN_SESSION_SECRET=

# Optional: Neon Postgres for shared/prod demos
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Demo safety / evals
CHAT_RATE_LIMIT_PER_HOUR=30
CHAT_MAX_STEPS=6
EVAL_CONCURRENCY=2
