# Environment template — copy to .env.local
# Never commit real API keys. `.env*` is gitignored (except this example).

# Tip: when piping into `vercel env add`, load dotenv quietly so its ◇ tip
# doesn't get captured into the secret (e.g. dotenv config({ quiet: true })).

# --- Model providers (set the ones you want to use) ---
# Anthropic Claude
ANTHROPIC_API_KEY=
# OpenAI
OPENAI_API_KEY=
# Google Gemini (AI SDK reads GOOGLE_GENERATIVE_AI_API_KEY; GEMINI_API_KEY also accepted)
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY=

# Optional default model override (must be in MODEL_REGISTRY)
# DEFAULT_MODEL=claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-5.6-terra
# GOOGLE_MODEL=gemini-3.8-flash

# Admin dashboard (/admin)
ADMIN_PASSWORD=changeme
# Optional: separate cookie signing secret (defaults to ADMIN_PASSWORD)
# ADMIN_SESSION_SECRET=

# Optional: Neon Postgres for shared/prod demos
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Demo safety / evals
CHAT_RATE_LIMIT_PER_HOUR=30
CHAT_MAX_STEPS=6
EVAL_CONCURRENCY=2
